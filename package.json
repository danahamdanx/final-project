{
  "name": "final-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "High-throughput log ingestion and query service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "fastify": "^5.11.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.1",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
